{
  "aviasales": {
    "description": "Travelpayouts Aviasales Data API: cached flight prices Aviasales users found recently (not live seats).",
    "base_url": "https://api.travelpayouts.com",
    "auth": {"type": "header", "name": "X-Access-Token", "env": "TRAVELPAYOUTS_TOKEN"},
    "rps": 5, "timeout_ms": 8000, "cache_ttl_s": 3600,
    "endpoints": {
      "prices_for_dates": {"method": "GET", "path": "/aviasales/v3/prices_for_dates", "params_in": "query"}
    }
  },
  "travelpayouts_places": {
    "description": "City or airport name -> IATA code, coordinates, Russian word forms. No key.",
    "base_url": "https://autocomplete.travelpayouts.com",
    "auth": {"type": "none"},
    "rps": 5, "timeout_ms": 5000, "cache_ttl_s": 604800,
    "endpoints": {
      "places2": {"method": "GET", "path": "/places2", "params_in": "query"}
    }
  },
  "yandex_rasp": {
    "description": "Yandex Rasp API v3.0: schedules for plane, train, suburban, bus, water, helicopter. Use the yandex-net.ru domain.",
    "base_url": "https://api.rasp.yandex-net.ru",
    "auth": {"type": "query", "name": "apikey", "env": "YANDEX_RASP_API_KEY"},
    "rps": 2, "timeout_ms": 8000, "cache_ttl_s": 21600,
    "attribution": "Данные предоставлены сервисом Яндекс.Расписания (активная ссылка http://rasp.yandex.ru/ рядом с данными на каждом экране)",
    "endpoints": {
      "search":             {"method": "GET", "path": "/v3.0/search/",             "params_in": "query"},
      "nearest_settlement": {"method": "GET", "path": "/v3.0/nearest_settlement/", "params_in": "query"},
      "thread":             {"method": "GET", "path": "/v3.0/thread/",             "params_in": "query"},
      "copyright":          {"method": "GET", "path": "/v3.0/copyright/",          "params_in": "query"}
    }
  },
  "wikipedia": {
    "description": "Leisure discovery: nearby Wikipedia articles; descriptions and images may be missing. No key.",
    "base_url": "https://ru.wikipedia.org",
    "auth": {"type": "none"},
    "headers": {"User-Agent": "godnota-hackathon/0.1 (https://github.com/ostrovok-hackathon-2026/godnota)"},
    "rps": 3, "timeout_ms": 8000, "cache_ttl_s": 604800,
    "attribution": "Wikipedia article: link and CC BY-SA 4.0 attribution; media: check each file's license and author.",
    "endpoints": {
      "geosearch": {"method": "GET", "path": "/w/api.php", "params_in": "query"}
    }
  },
  "nominatim": {
    "description": "Point geocoding for user searches only. Public server forbids systematic POI-list queries and autocomplete.",
    "base_url": "https://nominatim.openstreetmap.org",
    "auth": {"type": "none"},
    "headers": {"User-Agent": "godnota-hackathon/0.1 (https://github.com/ostrovok-hackathon-2026/godnota)"},
    "rps": 1, "timeout_ms": 8000, "cache_ttl_s": 2592000,
    "attribution": "© OpenStreetMap contributors",
    "endpoints": {
      "search":         {"method": "GET", "path": "/search", "params_in": "query"},
      "search_amenity": {"method": "GET", "path": "/search", "params_in": "query"}
    }
  },
  "osrm": {
    "description": "OSRM demo server: drive time and distance for transfers; reasonable non-commercial use only, at most 1 request per second.",
    "base_url": "https://router.project-osrm.org",
    "auth": {"type": "none"},
    "headers": {"User-Agent": "godnota-hackathon/0.1 (https://github.com/ostrovok-hackathon-2026/godnota)"},
    "rps": 1, "timeout_ms": 8000, "cache_ttl_s": 2592000,
    "attribution": "Route data: OpenStreetMap contributors (ODbL), routed by OSRM.",
    "endpoints": {
      "route": {"method": "GET", "path": "/route/v1/driving/{coordinates}", "params_in": "query"}
    }
  },
  "open_meteo": {
    "description": "Open-Meteo weather, history and sea temperature. Free non-commercial: <10000 calls/day, 5000/h, 600/min.",
    "base_url": "https://api.open-meteo.com",
    "auth": {"type": "none"},
    "rps": 5, "timeout_ms": 8000, "cache_ttl_s": 21600,
    "attribution": "Weather data by Open-Meteo.com (CC BY 4.0)",
    "endpoints": {
      "forecast": {"method": "GET", "path": "/v1/forecast", "params_in": "query"}
    }
  },
  "open_meteo_archive": {
    "description": "Open-Meteo historical weather (ERA5, 1940 onwards).",
    "base_url": "https://archive-api.open-meteo.com",
    "auth": {"type": "none"},
    "rps": 5, "timeout_ms": 8000, "cache_ttl_s": 2592000,
    "attribution": "Weather data by Open-Meteo.com (CC BY 4.0)",
    "endpoints": {
      "archive": {"method": "GET", "path": "/v1/archive", "params_in": "query"}
    }
  },
  "open_meteo_marine": {
    "description": "Open-Meteo marine: sea_surface_temperature (forecast 0-8 days, history from 2022).",
    "base_url": "https://marine-api.open-meteo.com",
    "auth": {"type": "none"},
    "rps": 5, "timeout_ms": 8000, "cache_ttl_s": 21600,
    "attribution": "Weather data by Open-Meteo.com (CC BY 4.0)",
    "endpoints": {
      "marine": {"method": "GET", "path": "/v1/marine", "params_in": "query"}
    }
  },
  "cbr": {
    "description": "Bank of Russia daily exchange rates (XML, windows-1251).",
    "base_url": "https://www.cbr.ru",
    "auth": {"type": "none"},
    "headers": {"Accept": "application/xml"},
    "rps": 1, "timeout_ms": 8000, "cache_ttl_s": 43200,
    "endpoints": {
      "daily": {"method": "GET", "path": "/scripts/XML_daily.asp", "params_in": "query"}
    }
  }
}
