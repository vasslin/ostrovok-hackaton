{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ostrovok-hackathon-2026/godnota/internal/providers/hotels-booking-finish",
  "properties": {
    "user": {
      "properties": {
        "email": {
          "type": "string",
          "format": "email"
        },
        "phone": {
          "type": "string",
          "maxLength": 32
        },
        "comment": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "email"
      ]
    },
    "partner": {
      "properties": {
        "partner_order_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "partner_order_id"
      ]
    },
    "language": {
      "type": "string",
      "enum": [
        "ru",
        "en"
      ]
    },
    "rooms": {
      "items": {
        "properties": {
          "guests": {
            "items": {
              "properties": {
                "first_name": {
                  "type": "string",
                  "maxLength": 64,
                  "minLength": 1
                },
                "last_name": {
                  "type": "string",
                  "maxLength": 64,
                  "minLength": 1
                },
                "is_child": {
                  "type": "boolean"
                },
                "age": {
                  "type": "integer",
                  "maximum": 17,
                  "minimum": 0,
                  "description": "Required for children."
                }
              },
              "additionalProperties": false,
              "type": "object",
              "required": [
                "first_name",
                "last_name"
              ]
            },
            "type": "array",
            "maxItems": 10,
            "minItems": 1
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "guests"
        ]
      },
      "type": "array",
      "maxItems": 9,
      "minItems": 1
    },
    "payment_type": {
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "now",
            "hotel",
            "deposit"
          ]
        },
        "amount": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$",
          "description": "Decimal string, as in ETG."
        },
        "currency_code": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "type",
        "amount",
        "currency_code"
      ]
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "user",
    "partner",
    "language",
    "rooms",
    "payment_type"
  ],
  "title": "hotels_mock.booking_finish request parameters"
}
