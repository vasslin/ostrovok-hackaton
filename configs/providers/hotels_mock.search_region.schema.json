{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ostrovok-hackathon-2026/godnota/internal/providers/hotels-search-region",
  "properties": {
    "checkin": {
      "type": "string",
      "format": "date",
      "description": "Not later than 730 days from today."
    },
    "checkout": {
      "type": "string",
      "format": "date",
      "description": "After checkin and not later than 30 days after it."
    },
    "residency": {
      "type": "string",
      "pattern": "^[a-z]{2}$",
      "description": "Guests' citizenship, ISO 3166-1 alpha-2 lowercase."
    },
    "language": {
      "type": "string",
      "enum": [
        "ru",
        "en"
      ]
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "guests": {
      "items": {
        "properties": {
          "adults": {
            "type": "integer",
            "maximum": 6,
            "minimum": 1
          },
          "children": {
            "items": {
              "type": "integer",
              "maximum": 17,
              "minimum": 0
            },
            "type": "array",
            "maxItems": 4,
            "description": "Ages of children in this room."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "adults",
          "children"
        ]
      },
      "type": "array",
      "maxItems": 9,
      "minItems": 1,
      "description": "One object per room."
    },
    "hotels_limit": {
      "type": "integer",
      "maximum": 500,
      "minimum": 1
    },
    "filter": {
      "properties": {
        "star_rating": {
          "items": {
            "type": "integer"
          },
          "type": "array",
          "description": "0 = no rating."
        },
        "kind": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "meal_type": {
          "type": "string",
          "enum": [
            "nomeal",
            "breakfast",
            "half-board",
            "full-board",
            "all-inclusive"
          ]
        },
        "price_from": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "Whole-stay price in the request currency."
        },
        "price_to": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "Whole-stay price in the request currency; greater than price_from."
        },
        "has_transfer": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "upsells": {
      "properties": {
        "early_checkin": {
          "properties": {
            "time": {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "time"
          ]
        },
        "late_checkout": {
          "properties": {
            "time": {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "time"
          ]
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "region_id": {
      "type": "integer",
      "minimum": 1,
      "description": "From multicomplete."
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "checkin",
    "checkout",
    "residency",
    "guests",
    "region_id"
  ],
  "title": "hotels_mock.search_region request parameters"
}
