{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ostrovok-hackathon-2026/godnota/internal/providers/hotels-booking-form",
  "properties": {
    "partner_order_id": {
      "type": "string",
      "format": "uuid",
      "description": "Our booking id; unique per booking attempt."
    },
    "book_hash": {
      "type": "string",
      "maxLength": 256,
      "minLength": 1
    },
    "language": {
      "type": "string",
      "enum": [
        "ru",
        "en"
      ]
    },
    "user_ip": {
      "type": "string",
      "description": "End user's IPv4 or IPv6 address."
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "partner_order_id",
    "book_hash",
    "language",
    "user_ip"
  ],
  "title": "hotels_mock.booking_form request parameters"
}
