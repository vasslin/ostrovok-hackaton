# Optional service addresses and ports. Defaults: see docker-compose.yml and service config.
HTTP_PORT=
TRAVEL_GRPC_ADDR=
SESSION_GRPC_ADDR=
USER_GRPC_ADDR=
ORDER_GRPC_ADDR=
AI_GRPC_ADDR=
MAP_GRPC_ADDR=
ROUTE_GRPC_ADDR=
PROVIDER_GRPC_ADDR=

# session-service context storage. memory is the local default; compose uses postgres.
SESSION_REPOSITORY=
SESSION_POSTGRES_DSN=
SESSION_PREVIOUS_CHATS_LIMIT=

# Travelpayouts: https://www.travelpayouts.com/ ; Yandex: https://rasp.yandex.ru/info/api
# Hotelbeds: https://developer.hotelbeds.com/ ; RateHawk: partner-issued API credentials.
# Keep credentials only in the local untracked .env; HOTELBEDS_MODE=test uses evaluation.
TRAVELPAYOUTS_TOKEN=
YANDEX_RASP_API_KEY=
HOTELBEDS_MODE=
HOTELBEDS_API_KEY=
HOTELBEDS_SECRET=
RATEHAWK_MODE=
RATEHAWK_KEY_ID=
RATEHAWK_API_KEY=

# AI. Empty LLM_PROVIDER in Docker Compose means offline: no Ollama and no API key.
# ollama uses travel-qwen:4b. Docker URL: http://host.docker.internal:11434/v1
# Native URL: http://localhost:11434/v1
# Optional Groq or OpenAI: set LLM_PROVIDER and a local LLM_API_KEY.
# SERVICE_API_KEY: optional service access secret, generated locally.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
SERVICE_API_KEY=

# New stage-2 implementation: demo never sends external HTTP requests.
PROVIDER_MODE=
AUTH_DATA_FILE=
CORS_ALLOWED_ORIGINS=
LLM_PROVIDER=
LLM_TIMEOUT=
SESSION_DB_PASSWORD=
MAX_CLARIFICATION_ROUNDS=
APP_PORT=
