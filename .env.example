# Локальный режим не использует ключ LLM; значения по умолчанию задаёт Compose.
# Ollama: https://ollama.com/; инструкция: LOCAL_QWEN.md
APP_PORT=
GRPC_PORT=
LLM_PROVIDER=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT=
# Только для облачного провайдера: отдельный ключ для жюри из его кабинета.
LLM_API_KEY=
# Секрет доступа backend к этому сервису, задаётся командой проекта.
SERVICE_API_KEY=

# Дополнительный стек docker-compose.session.yml: пароль локальной БД сессий.
SESSION_DB_PASSWORD=
