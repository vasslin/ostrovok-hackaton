# Container addresses used by the current main branch.
HTTP_PORT=8080
TRAVEL_GRPC_ADDR=travel-service:50051
SESSION_GRPC_ADDR=session-service:50052
USER_GRPC_ADDR=user-service:50053
ORDER_GRPC_ADDR=order-service:50054
AI_GRPC_ADDR=ai-service:50055
MAP_GRPC_ADDR=map-service:50056
ROUTE_GRPC_ADDR=route-service:50057
PROVIDER_GRPC_ADDR=provider-service:50058

# session-service context storage. memory is the local default; compose uses postgres.
SESSION_REPOSITORY=postgres
SESSION_POSTGRES_DSN=postgres://session:session@session-db:5432/session?sslmode=disable
SESSION_PREVIOUS_CHATS_LIMIT=4

# External provider credentials. Set real values only in a local untracked file.
TRAVELPAYOUTS_TOKEN=
YANDEX_RASP_API_KEY=
HOTELBEDS_MODE=
HOTELBEDS_API_KEY=
HOTELBEDS_SECRET=
RATEHAWK_MODE=
RATEHAWK_KEY_ID=
RATEHAWK_API_KEY=

# AI service credentials and endpoint after its branch is integrated.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=
SERVICE_API_KEY=

# New stage-2 implementation: demo never sends external HTTP requests.
PROVIDER_MODE=demo
AUTH_DATA_FILE=data/auth.json
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173
